# --- Database ---
# Default: local SQLite file, zero setup needed.
DATABASE_URL="file:./dev.db"
# For Postgres in production, switch provider in prisma/schema.prisma to "postgresql" and use e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret"

# --- AI Agent ---
# Optional. If set, the agent calls the real Anthropic API.
# If left empty, the agent falls back to a built-in mock responder so the app
# still runs end-to-end with no external key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
