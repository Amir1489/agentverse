# --- Database ---
# PostgreSQL connection string (required). Get a free one from Neon, Supabase,
# Railway, etc. Example:
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# For local-only dev without a Postgres server, switch provider in
# prisma/schema.prisma back to "sqlite" and use DATABASE_URL="file:./dev.db".

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret"

# --- AI Agent ---
# Optional. If set, the agent calls the real Anthropic API.
# If left empty, the agent falls back to a built-in mock responder so the app
# still runs end-to-end with no external key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
